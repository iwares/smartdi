{
  "compilerOptions": {
    "target": "ES6",
    "lib": [
      "ES2017"
    ],
    "module": "Node16",
    "declaration": true,
    "stripInternal": true,
    "moduleResolution": "Node16",
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "removeComments": true,
    "isolatedModules": true,
    "types": [
      "node",
      "jest"
    ]
  },
  "include": [
    "index.ts",
    "test/**/*.ts"
  ]
}
